<Window x:Class="DeadlockMVM.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DeadlockMVM.Core;assembly=DeadlockMVM.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Deadlock MVM Launcher"
        Width="560"
        MinWidth="480"
        Height="520"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom, dark title bar. -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="14,0,0,0">
                        <Border Width="3"
                                Height="13"
                                Background="{StaticResource AccentBrush}"
                                Margin="0,0,8,0" />
                        <TextBlock Text="DEADLOCK MVM" Style="{StaticResource TitleBarText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource WindowControlButton}"
                                ToolTip="Minimize"
                                Click="MinimizeButton_Click">
                            <TextBlock Text="—" FontSize="14" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource WindowCloseButton}"
                                ToolTip="Close"
                                Click="CloseButton_Click">
                            <TextBlock Text="×" FontSize="17" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Minimal navigation. -->
            <StackPanel Grid.Row="1" Margin="28,9,28,7" Orientation="Horizontal">
                <Button Content="HOME"
                        Style="{StaticResource NavHomeButton}"
                        Command="{Binding ShowHomeCommand}" />
                <Button Content="REPLAYS"
                        Style="{StaticResource NavReplaysButton}"
                        Command="{Binding ShowReplaysCommand}" />
            </StackPanel>
            <Border Grid.Row="1"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="{StaticResource BorderBrush}" />

            <!-- ============ HOME ============ -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReplaysPage}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="28,16,28,16">
                    <!-- Installation -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DEADLOCK" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{Binding PathActionText}"
                                    Style="{StaticResource SmallButton}"
                                    Click="LocateDeadlockButton_Click" />
                            <Button Content="Folder"
                                    Style="{StaticResource SmallButton}"
                                    Margin="6,0,0,0"
                                    Click="LocateDeadlockFolderButton_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding DeadlockInstallText}"
                               Style="{StaticResource StatusText}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding DeadlockPathDisplay}"
                               Style="{StaticResource MutedText}"
                               ToolTip="{Binding DeadlockPath}"
                               Margin="0,3,0,0" />

                    <!-- Selected replay -->
                    <TextBlock Text="SELECTED REPLAY"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,17,0,0" />
                    <TextBlock Text="{Binding SelectedReplayName}"
                               Style="{StaticResource BodyText}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding SelectedReplayPathText}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               ToolTip="{Binding SelectedReplayPathText}"
                               Margin="0,3,0,0" />
                    <Button Content="Browse Replays"
                            Style="{StaticResource SmallButton}"
                            HorizontalAlignment="Left"
                            Command="{Binding ShowReplaysCommand}"
                            Margin="0,8,0,0" />

                    <!-- Launch arguments -->
                    <TextBlock Text="Additional launch arguments"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,17,0,0" />
                    <TextBox Style="{StaticResource DarkTextBox}"
                              Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Movie Mode always supplies -insecure -dev -console -condebug. Add optional arguments here."
                             Margin="0,7,0,0" />

                    <CheckBox Content="Hide launcher while Deadlock is running"
                              IsChecked="{Binding HideLauncherWhileDeadlockRunning, Mode=TwoWay}"
                              Foreground="{StaticResource TextMutedBrush}"
                              Margin="0,10,0,0"
                              ToolTip="Keeps the SMVM host running in the background and restores this window when Deadlock closes." />

                    <CheckBox Content="Launch through Steam (off = direct, recommended for replays)"
                              IsChecked="{Binding LaunchViaSteam, Mode=TwoWay}"
                              Foreground="{StaticResource TextMutedBrush}"
                              Margin="0,6,0,0"
                              ToolTip="Steam forwarding can drop +playdemo after game updates and land in the normal menu. Direct launch keeps the replay arguments on the game command line. Keep Steam running either way." />

                    <Button Content="{Binding PlayButtonText}"
                            Style="{StaticResource LaunchButton}"
                            Command="{Binding LaunchCommand}"
                            Margin="0,18,0,0" />

                    <Button Content="EXIT DEADLOCK (FORCE)"
                            Command="{Binding StopDeadlockCommand}"
                            Margin="0,8,0,0"
                            ToolTip="Immediately force-closes the running Deadlock process.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LaunchButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeadlockRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Advanced -->
                    <Expander Margin="0,14,0,0" Style="{StaticResource CompactExpander}">
                        <Expander.Header>
                            <TextBlock Text="Advanced" Style="{StaticResource StatusText}" />
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Final launch command" Style="{StaticResource SectionLabel}" />
                            <TextBox Style="{StaticResource ReadOnlyCommand}"
                                     Text="{Binding CommandPreview, Mode=OneWay}"
                                     Margin="0,6,0,0" />
                            <TextBlock Text="Keybinds" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                            <Button Content="Open keyboard + mouse" Click="OpenKeyboardBindings_Click" Padding="12,8" HorizontalAlignment="Left" />
                            <TextBlock Text="Developer console (optional; the game's console stays available)"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,12,0,6" />
                            <Button Content="Open developer console"
                                    Click="OpenDevConsole_Click"
                                    Padding="12,8"
                                    HorizontalAlignment="Left" />
                            <Grid Margin="0,10,0,0">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Button Content="Open logs"
            Style="{StaticResource SmallButton}"
            Command="{Binding OpenLogsCommand}" />
    <Button Content="Reset detected path"
            Grid.Column="1"
            Style="{StaticResource SmallButton}"
            Command="{Binding ResetDeadlockPathCommand}"
            Margin="8,0,0,0" />
</Grid>
                        </StackPanel>
                    </Expander>

                    <!-- Version footer -->
                    <Grid Margin="0,12,0,0" MinHeight="20">
                        <TextBlock Text="{x:Static core:ProductInfo.DisplayVersion}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ REPLAYS ============ -->
            <Grid Grid.Row="2"
                  Margin="28,14,28,14"
                  IsSharedSizeScope="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReplaysPage}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header + actions -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="REPLAYS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Import Demo"
                            Style="{StaticResource SmallButton}"
                            Click="ImportReplayButton_Click" />
                    <Button Grid.Column="2"
                            Content="Open Folder"
                            Style="{StaticResource SmallButton}"
                            Command="{Binding OpenReplayFolderCommand}"
                            Margin="6,0,0,0" />
                    <Button Grid.Column="3"
                            Content="Refresh"
                            Style="{StaticResource SmallButton}"
                            Command="{Binding RefreshReplaysCommand}"
                            Margin="6,0,0,0" />
                </Grid>

                <!-- Column headers -->
                <Grid Grid.Row="1"
                      Margin="0,10,0,5"
                      Background="{StaticResource SurfaceBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SizeColumn" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModifiedColumn" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Filename"
                               Style="{StaticResource MutedText}"
                               Margin="10,4,12,4" />
                    <TextBlock Grid.Column="1"
                               Text="Size"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,14,4" />
                    <TextBlock Grid.Column="2"
                               Text="Modified"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,10,4" />
                </Grid>

                <!-- Demo list (only this scrolls) -->
                <ListBox Grid.Row="2"
                         Style="{StaticResource ReplayListBox}"
                         ItemsSource="{Binding Replays}"
                         SelectedItem="{Binding SelectedReplay, Mode=TwoWay}"
                         MouseDoubleClick="ReplayList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="SizeColumn" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ModifiedColumn" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FileName}"
                                           Style="{StaticResource BodyText}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="10,7,12,7" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FileSizeText}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="0,7,14,7" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ModifiedDateText}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="0,7,10,7" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Scan status -->
                <TextBlock Grid.Row="3"
                           Text="{Binding ReplayStatusText}"
                           Style="{StaticResource MutedText}"
                           ToolTip="{Binding ReplayDirectoryPath}"
                           Margin="0,7,0,0" />

                <!-- Selection + actions -->
                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Selected:" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding SelectedReplayName}"
                                   Style="{StaticResource StatusText}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="USE THIS REPLAY"
                            Style="{StaticResource SmallButton}"
                            VerticalAlignment="Center"
                            Command="{Binding UseSelectedReplayCommand}" />
                    <Button Grid.Column="2"
                            Content="{Binding PlayButtonText}"
                            Style="{StaticResource SmallButton}"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Command="{Binding LaunchCommand}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
