<Window x:Class="DeadlockMVM.Launcher.Director.DirectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeadlockMVM.Launcher.Director"
        Title="Deadlock MVM Director"
        Width="380"
        Height="500"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Background="{StaticResource BackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar / drag handle -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0">
                        <Border Width="3" Height="12" Background="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="MVM DIRECTOR" Style="{StaticResource TitleBarText}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" ToolTip="Hide (hotkey to show)" Click="HideButton_Click" Margin="0,0,6,0">
                        <TextBlock Text="✕" FontSize="14" />
                    </Button>
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="1" Margin="10,6,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation rail -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Command="{Binding SelectCommand}"
                                        IsEnabled="{Binding Enabled}"
                                        Style="{StaticResource NavButton}"
                                        ToolTip="{Binding Enabled, Converter={StaticResource BoolToToolTip}, ConverterParameter='Click to select|Coming in a later milestone'}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Content area -->
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="2" Visibility="{Binding IsReplayPage, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="14,7,14,7">
                            <!-- Connection + replay name -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ReplayName}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{Binding IsConnected, Converter={StaticResource BoolToBrush}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6,0,6" />

                            <!-- Tick display -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TICK" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CurrentTick}" Style="{StaticResource BigNumber}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding TotalTicks, StringFormat=' / {0}'}" Style="{StaticResource MutedBigNumber}" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </Grid>

                            <TextBlock Text="{Binding PlaybackState}" Style="{StaticResource StatusText}" Foreground="{Binding PlaybackState, Converter={StaticResource StateToBrush}}" Margin="0,2,0,6" />

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,8" />

                            <!-- Transport controls -->
                            <TextBlock Text="TRANSPORT" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                <Button Content="⏮" Style="{StaticResource TransportButton}" Command="{Binding StepBackCommand}" ToolTip="Step back 1 tick" />
                                <Button Content="{Binding PlaybackToggleGlyph}" Style="{StaticResource TransportButton}" Command="{Binding TogglePlaybackCommand}" ToolTip="{Binding PlaybackToggleToolTip}" Margin="4,0,0,0" />
                                <Button Content="⏭" Style="{StaticResource TransportButton}" Command="{Binding StepForwardCommand}" ToolTip="Step forward 1 tick" Margin="4,0,0,0" />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,7,0,6" />

                            <!-- Speed presets -->
                            <TextBlock Text="SPEED" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />

                            <ItemsControl ItemsSource="{Binding SpeedPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                ContentStringFormat="0.##x"
                                                Command="{Binding DataContext.SetSpeedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SpeedPresetButton}"
                                                Margin="2,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding TimescaleDisplay}" Style="{StaticResource StatusText}" HorizontalAlignment="Center" Margin="0,4,0,6" />

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6,0,6" />

                            <!-- Go to tick -->
                            <TextBlock Text="GO TO TICK" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}" Text="{Binding GotoTickValue, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="6,2" />
                                <Button Grid.Column="1" Content="GO" Style="{StaticResource SmallButton}" Command="{Binding GotoTickCommand}" Margin="6,0,0,0" MinWidth="50" />
                            </Grid>

                        </StackPanel>
                </Border>

                <!-- ============ CAMERA ============ -->
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="2" Visibility="{Binding IsCameraPage, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="14,9,14,8" DataContext="{Binding Camera}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CAMERA V0.4" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource MutedText}" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,7,0,7" />

                        <!-- Live: updates continuously while this page is visible and connected -->
                        <TextBlock Text="ACTIVE TRANSFORM" Style="{StaticResource SectionLabel}" />
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="POSITION" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="ROTATION" Style="{StaticResource MutedText}" FontWeight="SemiBold" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="X" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PosXText}" FontFamily="Consolas" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Pitch" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding PitchText}" FontFamily="Consolas" Style="{StaticResource MutedText}" Margin="8,0,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Y" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PosYText}" FontFamily="Consolas" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Yaw" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding YawText}" FontFamily="Consolas" Style="{StaticResource MutedText}" Margin="8,0,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Z" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PosZText}" FontFamily="Consolas" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="Roll" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding RollText}" FontFamily="Consolas" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,9,0,7" />

                        <TextBlock Text="PLAYER / POV" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding PlayerSlotText}" Style="{StaticResource BodyText}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,2"
                                   ToolTip="Tracked from MVM actions — engine does not expose a spectator-target query." />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="◀ PREV" Style="{StaticResource SmallButton}" Command="{Binding PrevPlayerCommand}" />
                            <Button Content="NEXT ▶" Style="{StaticResource SmallButton}" Command="{Binding NextPlayerCommand}" Margin="6,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Content="IN EYE" Style="{StaticResource SmallButton}" Command="{Binding InEyeCommand}"
                                    Foreground="{Binding IsInEyeActive, Converter={StaticResource BoolToAccent}}" />
                            <Button Content="CHASE" Style="{StaticResource SmallButton}" Command="{Binding ChaseCommand}" Margin="6,0,0,0"
                                    Foreground="{Binding IsChaseActive, Converter={StaticResource BoolToAccent}}" />
                            <Button Content="FREE ROAM" Style="{StaticResource SmallButton}" Command="{Binding FreeRoamCommand}" Margin="6,0,0,0"
                                    Foreground="{Binding IsFreeRoamActive, Converter={StaticResource BoolToAccent}}" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,9,0,7" />

                        <TextBlock Text="FOV" Style="{StaticResource SectionLabel}" />

                        <!-- Editor: shown only while active-camera FOV control is live-proven available -->
                        <StackPanel Visibility="{Binding IsFovEditorVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ActiveFovText}" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Width="62" Style="{StaticResource DarkTextBox}" Padding="6,3"
                                         Text="{Binding FovInputText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="FovInput_KeyDown" GotFocus="FovInput_GotFocus" LostFocus="FovInput_LostFocus"
                                         ToolTip="Exact FOV in degrees (5–170). Enter applies." />
                            </Grid>
                            <Slider Style="{StaticResource DarkSlider}" Margin="0,5,0,0"
                                    Value="{Binding FovSliderValue, Mode=OneWay}"
                                    ValueChanged="FovSlider_ValueChanged"
                                    PreviewMouseLeftButtonDown="FovSlider_DragStarted"
                                    PreviewMouseLeftButtonUp="FovSlider_DragCompleted" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                <Button Content="20" Style="{StaticResource SmallButton}" Command="{Binding SetFovPresetCommand}" CommandParameter="20" />
                                <Button Content="30" Style="{StaticResource SmallButton}" Command="{Binding SetFovPresetCommand}" CommandParameter="30" Margin="6,0,0,0" />
                                <Button Content="40" Style="{StaticResource SmallButton}" Command="{Binding SetFovPresetCommand}" CommandParameter="40" Margin="6,0,0,0" />
                                <Button Content="60" Style="{StaticResource SmallButton}" Command="{Binding SetFovPresetCommand}" CommandParameter="60" Margin="6,0,0,0" />
                                <Button Content="90" Style="{StaticResource SmallButton}" Command="{Binding SetFovPresetCommand}" CommandParameter="90" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Unavailable state: informational only, no fake control -->
                        <Grid Visibility="{Binding IsFovEditorVisible, Converter={StaticResource InverseBoolToVisibility}}" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Active Camera" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Column="1" Text="{Binding ActiveFovText}" Style="{StaticResource MutedText}" Margin="10,0,0,0"
                                       ToolTip="{Binding Capabilities.Limitation}" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,9,0,7" />
                        <TextBlock Text="SAVE / RESTORE" Style="{StaticResource SectionLabel}" />
                        <StackPanel Visibility="{Binding IsSaveRestoreVisible, Converter={StaticResource BoolToVisibility}}"
                                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                            <Button Content="SAVE CAMERA" Style="{StaticResource SmallButton}" Command="{Binding SaveCameraCommand}" />
                            <Button Content="RESTORE CAMERA" Style="{StaticResource SmallButton}" Command="{Binding RestoreCameraCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding RestoreLimitation}"
                                   ToolTip="{Binding Capabilities.Limitation}"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding IsSaveRestoreVisible, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- ============ DOLLY / CAMPATH ============ -->
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="2"
                        Visibility="{Binding IsDollyPage, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="14,9,14,8" DataContext="{Binding Campath}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DOLLY / CAMPATH" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding NativeState}" Style="{StaticResource MutedText}" />
                        </Grid>
                        <TextBlock Text="{Binding NativeMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,7,0,7" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LINEAR PATH" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding KeyframeCount}" Style="{StaticResource MutedText}" />
                        </Grid>

                        <ListBox ItemsSource="{Binding Keyframes}" SelectedItem="{Binding SelectedKeyframe}"
                                 Height="174" Margin="0,6,0,0" Background="{StaticResource SurfaceAltBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="7,5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DemoTick, StringFormat=TICK {0}}" FontFamily="Consolas"
                                                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                            <TextBlock FontFamily="Consolas" Style="{StaticResource MutedText}">
                                                <Run Text="XYZ " /><Run Text="{Binding Camera.X, StringFormat={}{0:0.000}}" />
                                                <Run Text="  " /><Run Text="{Binding Camera.Y, StringFormat={}{0:0.000}}" />
                                                <Run Text="  " /><Run Text="{Binding Camera.Z, StringFormat={}{0:0.000}}" />
                                            </TextBlock>
                                            <TextBlock FontFamily="Consolas" Style="{StaticResource MutedText}">
                                                <Run Text="P/Y/R " /><Run Text="{Binding Camera.Pitch, StringFormat={}{0:0.000}}" />
                                                <Run Text="  " /><Run Text="{Binding Camera.Yaw, StringFormat={}{0:0.000}}" />
                                                <Run Text="  " /><Run Text="{Binding Camera.Roll, StringFormat={}{0:0.000}}" />
                                                <Run Text="   FOV " /><Run Text="{Binding Camera.Fov, StringFormat={}{0:0.00}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                            <Button Content="ADD" Style="{StaticResource SmallButton}" Command="{Binding AddCommand}" />
                            <Button Content="UPDATE" Style="{StaticResource SmallButton}" Command="{Binding UpdateCommand}" Margin="5,0,0,0" />
                            <Button Content="DELETE" Style="{StaticResource SmallButton}" Command="{Binding DeleteCommand}" Margin="5,0,0,0" />
                            <Button Content="CLEAR" Style="{StaticResource SmallButton}" Command="{Binding ClearCommand}" Margin="5,0,0,0" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,7" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="PLAY PATH" Style="{StaticResource SmallButton}" Command="{Binding PlayCommand}" MinWidth="92" />
                            <Button Content="STOP" Style="{StaticResource SmallButton}" Command="{Binding StopCommand}" Margin="7,0,0,0" MinWidth="68" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <!-- Placeholder for later pages -->
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="2" Visibility="{Binding IsOtherPage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SelectedNav.Name, StringFormat={}{0} — coming in a later milestone}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
